# Copy to .env and change the passwords. `.env` is gitignored.
# Local stand-ins for AWS services - see docs/adr/0001-local-first-aws-parity.md

# --- PostgreSQL / TimescaleDB (stand-in for Aurora PostgreSQL) ---
POSTGRES_DB=smart_campus
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=change-me-admin
# Least-privilege service roles (created by db/init/001_roles_schemas.sh)
INGEST_DB_PASSWORD=change-me-ingest
TRANSFORM_DB_PASSWORD=change-me-transform
BI_DB_PASSWORD=change-me-bi

# --- S3 raw landing zone (SeaweedFS locally) ---
RAW_BUCKET=smart-campus-raw

# --- Grafana / Metabase ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Simulator ---
SITE_ID=Lamb
# Simulated hours published per real second (1 = one hour of campus data every second)
SIM_SPEEDUP=1
# Probability that a single reading is corrupted (spike / stuck / negative / malformed)
SIM_FAULT_RATE=0.002
SIM_START=2017-07-01T00:00:00Z
