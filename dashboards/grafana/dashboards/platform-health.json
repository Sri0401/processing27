    {
      "id": 9,
      "type": "table",
      "title": "Latest anomalies from the live stream",
      "description": "Spikes and stuck sensors detected in streamed telemetry - triage with the BMS contractor.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select reading_ts as \"Reading time\", building_name || ' · ' || meter as \"Meter\", anomaly_type as \"Type\", observed_kwh as \"Observed kWh\", expected_kwh as \"Expected kWh\" from marts.mart_energy_anomalies where load_source = 'stream' order by reading_ts desc limit 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Observed kWh"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expected kWh"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Meters with the lowest completeness",
      "description": "Data completeness per meter across the full history.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select building_name || ' · ' || meter as \"Meter\", completeness as \"Completeness\", stuck_readings as \"Flat-line hrs\" from marts.mart_data_quality order by completeness limit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
