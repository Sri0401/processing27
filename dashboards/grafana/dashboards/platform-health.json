{
  "uid": "platform-health",
  "title": "Platform Health & Live Telemetry",
  "description": "Pipeline throughput, dead-lettered messages and telemetry data quality.",
  "tags": [
    "smart-campus"
  ],
  "timezone": "Europe/London",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Platform health - for the data engineer and BMS team.** Live view of the telemetry pipeline (wall-clock time): ingestion throughput, contract violations sent to the dead-letter table, and meter data quality."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Readings ingested (last 15 min)",
      "description": "Streamed readings written to the raw layer in the last 15 minutes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(readings), 0) from raw.v_ingest_health where minute > now() - interval '15 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#52514e",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejected messages (24 h)",
      "description": "Messages that broke the telemetry contract and were dead-lettered.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(rejects), 0) from raw.v_reject_summary"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Meters below 95% completeness",
      "description": "Building meters with more than 5% of hourly readings missing (as of the last dbt run).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) from marts.mart_data_quality where completeness < 0.95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
