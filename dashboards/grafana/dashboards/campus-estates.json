            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select sum(total_cost_gbp) filter (where work_type = 'reactive') / sum(total_cost_gbp) from marts.fct_work_orders where extract(year from raised_date) = 2017"
