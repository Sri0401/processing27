          "rawQuery": true,
          "rawSql": "select building_name as \"Building\", asset_class as \"Asset\", condition_grade as \"Grade\", age_years as \"Age\", remaining_life_years as \"Life left (yrs)\", reactive_jobs_ref_year as \"Repairs 2017\", replacement_cost_gbp as \"Replacement £\", investment_priority as \"Priority\" from marts.mart_asset_condition where investment_priority like '1%' or investment_priority like '2%' order by risk_score desc, replacement_cost_gbp desc limit 100"
