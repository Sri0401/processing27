    {
      "id": 7,
      "type": "timeseries",
      "title": "Monthly maintenance spend - reactive vs planned",
      "description": "Total cost of completed and open work orders raised each month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select month_start::timestamptz as time, 'reactive' as metric, sum(reactive_cost_gbp) as value from marts.mart_maintenance_spend_monthly where $__timeFilter(month_start) group by 1 union all select month_start::timestamptz, 'planned', sum(planned_cost_gbp) from marts.mart_maintenance_spend_monthly where $__timeFilter(month_start) group by 1 order by 1"
        }
      ],
