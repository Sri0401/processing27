          "rawSql": "select building_name as \"Building\", space_usage as \"Use\", eui_kwh_m2 as \"kWh/m²\", eui_vs_peer_median as \"vs typical\" from marts.mart_building_energy_kpis where meter = 'electricity' and eui_kwh_m2 is not null and building_id in (${building:sqlstring}) order by eui_vs_peer_median desc"
