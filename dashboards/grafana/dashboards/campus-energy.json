      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select building_name as \"Building\", meter as \"Meter\", unoccupied_share as \"Out-of-hours share\", peer_median_unoccupied_share as \"Typical\", savings_gbp as \"Saving £/yr\", savings_tco2e as \"tCO₂e/yr\" from marts.mart_out_of_hours_opportunity where savings_kwh > 0 and building_id in (${building:sqlstring}) order by savings_gbp desc limit 25"
        }
