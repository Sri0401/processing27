    {
      "id": 7,
      "type": "timeseries",
      "title": "Daily consumption by meter",
      "description": "Total kWh per day. Gas rises in winter (heating); electricity dips in vacations. Gaps are days when fewer than 80% of meters reported valid data (source data outages).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select local_date::timestamptz as time, meter as metric, case when count(kwh) >= 0.8 * max(count(kwh)) over (partition by meter) then sum(kwh) end as value from marts.fct_energy_daily where $__timeFilter(local_date) and building_id in (${building:sqlstring}) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
