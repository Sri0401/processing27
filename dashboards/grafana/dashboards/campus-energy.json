    {
      "id": 9,
      "type": "table",
      "title": "Top out-of-hours saving opportunities",
      "description": "Buildings using a larger share of their energy outside occupied hours than similar buildings (same space use). Typical actions: BMS time-schedule review, heating set-back, plug-load and lighting controls.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 11
