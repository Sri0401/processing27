    {
      "id": 8,
      "type": "barchart",
      "title": "Typical electricity profile (avg kWh by hour)",
      "description": "Average campus load at each hour of the day. A high overnight / weekend line is energy used while buildings are empty.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "campus-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "campus-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select lpad(local_hour::text, 2, '0') || ':00' as hour, avg(kwh) filter (where not is_weekend) as weekday, avg(kwh) filter (where is_weekend) as weekend from (select local_date, local_hour, is_weekend, sum(kwh_clean) as kwh from marts.fct_energy_hourly where meter = 'electricity' and $__timeFilter(reading_ts) and building_id in (${building:sqlstring}) group by 1, 2, 3) h group by local_hour order by local_hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "custom": {
